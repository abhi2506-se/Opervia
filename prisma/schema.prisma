// ============================================================================
// Prisma schema — Agency Management Platform
// Phase 1 scope: Auth, RBAC, Leads, Clients, Projects, Milestones, Documents,
// Audit Log, and the foundational tables for Proposals/Commissions/Payments
// so later phases attach without a schema rewrite.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth & Roles
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  AGENT
  CLIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  name          String
  phone         String?
  image         String?
  role          Role
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?

  // Role-specific profile rows (only one will be populated based on `role`)
  agentProfile  Agent?
  clientProfile Client?

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs      AuditLog[]      @relation("AuditActor")
  notifications  Notification[]
  uploadedDocs   Document[]      @relation("DocumentUploader")
  emailsCreated  EmailMessage[]  @relation("EmailCreatedBy")

  @@index([role])
  @@index([status])
}

// NextAuth (Auth.js) required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

model Agent {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation   String?
  territories   String[]   @default([])
  notes         String?    @db.Text

  leads         Lead[]
  clients       Client[]   @relation("AssignedAgent")
  projects      Project[]  @relation("AssignedAgentProject")

  proposals        Proposal[]
  emailThreads     EmailThread[]
  emailMessages    EmailMessage[]
  emailDrafts      EmailDraft[]
  salesActivities  SalesActivity[]
  tasks            Task[]
  commissions      Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

model Client {
  id                String   @id @default(cuid())
  userId            String?  @unique // set once the client has a login
  user              User?    @relation(fields: [userId], references: [id])

  name              String
  email             String   @unique
  phone             String?
  company           String?
  country           String?
  preferredLanguage String   @default("en")
  city              String?
  website           String?
  companyDescription String? @db.Text
  profileImage      String?
  emailVerifiedAt   DateTime?
  termsAcceptedAt   DateTime?

  assignedAgentId String?
  assignedAgent   Agent?  @relation("AssignedAgent", fields: [assignedAgentId], references: [id])

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id])

  projects  Project[]
  documents Document[]

  proposals       Proposal[]
  emailThreads    EmailThread[]
  emailMessages   EmailMessage[]
  salesActivities SalesActivity[]
  tasks           Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedAgentId])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  CONVERTED
}

model Lead {
  id       String     @id @default(cuid())
  name     String
  email    String
  phone    String?
  company  String?
  country  String?
  website  String?
  industry String?
  source   String?
  notes    String?    @db.Text
  status   LeadStatus @default(NEW)
  score    Int        @default(0)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  convertedClient Client?

  proposals       Proposal[]
  emailThreads    EmailThread[]
  emailMessages   EmailMessage[]
  salesActivities SalesActivity[]
  tasks           Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  SUBMITTED
  NEEDS_INFORMATION
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  WAITING_FOR_REVIEW
  ACCEPTED
  REJECTED
  PLANNING
  UI_UX
  DEVELOPMENT
  TESTING
  CLIENT_REVIEW
  ON_HOLD
  FINAL_DELIVERY
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])

  assignedAgentId String?
  assignedAgent   Agent?  @relation("AssignedAgentProject", fields: [assignedAgentId], references: [id])

  projectType    String
  description    String   @db.Text
  requirements   String?  @db.Text
  targetAudience String?
  deadline       DateTime?
  budgetEstimate Decimal? @db.Decimal(12, 2)
  referenceUrls  String[] @default([])

  technologies   String[] @default([])

  totalValue    Decimal? @db.Decimal(12, 2)
  advanceAmount Decimal? @db.Decimal(12, 2)
  currency      String   @default("INR")

  status        ProjectStatus @default(SUBMITTED)
  rejectionReason String?     @db.Text
  onHoldFromStatus ProjectStatus?

  milestones      Milestone[]
  documents       Document[]
  statusHistory   ProjectStatusHistory[]
  tasks           Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([assignedAgentId])
  @@index([status])
}

model ProjectStatusHistory {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus ProjectStatus?
  toStatus   ProjectStatus
  changedById String
  note       String?      @db.Text
  createdAt  DateTime     @default(now())

  @@index([projectId])
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED_FOR_APPROVAL
  APPROVED
  CHANGES_REQUESTED
  COMPLETED
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?         @db.Text
  percentage  Int
  startDate   DateTime?
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  requiresClientApproval Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Documents (metadata only — binary lives in object storage)
// ---------------------------------------------------------------------------

enum DocumentType {
  REQUIREMENT
  BRAND_ASSET
  PROPOSAL
  INVOICE
  CONTRACT
  REPORT
  SOURCE_DELIVERABLE
  OTHER
}

model Document {
  id           String       @id @default(cuid())
  filename     String
  storageKey   String       // key/path in the object storage bucket, never a public URL
  mimeType     String
  sizeBytes    Int
  documentType DocumentType @default(OTHER)
  version      Int          @default(1)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  clientId String?
  client   Client?  @relation(fields: [clientId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  proposals Proposal[]

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String
  title   String
  body    String?  @db.Text
  read    Boolean  @default(false)
  metadata Json?
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// Audit Log (append-only)
// ---------------------------------------------------------------------------

enum AuditStatus {
  SUCCESS
  FAILED
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation("AuditActor", fields: [actorId], references: [id])
  actorRole  Role
  // Denormalized on write so historical rows still show a name/email even if
  // the User record is later renamed or removed.
  actorName  String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  description String?    @db.Text
  previousValue Json?
  newValue      Json?
  status     AuditStatus @default(SUCCESS)
  errorDetail String?    @db.Text
  metadata   Json?
  ipAddress  String?
  userAgent  String?     @db.Text
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Proposals
// ---------------------------------------------------------------------------

enum ProposalStatus {
  DRAFT
  READY
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  CHANGE_REQUESTED
  EXPIRED
  CANCELLED
}

model Proposal {
  id          String         @id @default(cuid())
  title       String
  agentId     String
  agent       Agent          @relation(fields: [agentId], references: [id])
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id])
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id])
  amount      Decimal?       @db.Decimal(12, 2)
  currency    String         @default("INR")
  status      ProposalStatus @default(DRAFT)
  documentId  String?
  document    Document?      @relation(fields: [documentId], references: [id])
  sentAt      DateTime?
  respondedAt DateTime?

  emailMessages EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([leadId])
  @@index([clientId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Email system
// ---------------------------------------------------------------------------

enum EmailType {
  PROPOSAL
  SALES
  GENERAL
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
  REPLIED
  CANCELLED
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

model EmailThread {
  id            String    @id @default(cuid())
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id])
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id])
  subject       String
  status        String    @default("OPEN")
  lastMessageAt DateTime?

  messages EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([clientId])
  @@index([leadId])
}

model EmailMessage {
  id                String      @id @default(cuid())
  threadId          String?
  thread            EmailThread? @relation(fields: [threadId], references: [id])
  createdByUserId   String
  createdBy         User        @relation("EmailCreatedBy", fields: [createdByUserId], references: [id])
  agentId           String
  agent             Agent       @relation(fields: [agentId], references: [id])
  emailType         EmailType
  direction         EmailDirection @default(OUTBOUND)
  fromEmail         String
  fromName          String
  toEmails          String[]
  ccEmails          String[]    @default([])
  bccEmails         String[]    @default([])
  replyTo           String?
  subject           String
  htmlBody          String      @db.Text
  textBody          String?     @db.Text
  status            EmailStatus @default(DRAFT)
  readAt            DateTime?
  important         Boolean     @default(false)
  archivedAt        DateTime?

  proposalId        String?
  proposal          Proposal?   @relation(fields: [proposalId], references: [id])
  leadId            String?
  lead              Lead?       @relation(fields: [leadId], references: [id])
  clientId          String?
  client            Client?     @relation(fields: [clientId], references: [id])

  providerMessageId String?     @unique
  providerThreadId  String?

  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?
  bouncedAt   DateTime?
  failedAt    DateTime?
  failureReason String? @db.Text

  attachments EmailAttachment[]
  events      EmailEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([clientId])
  @@index([leadId])
  @@index([emailType])
  @@index([status])
  @@index([createdAt])
  @@index([threadId])
}

model EmailAttachment {
  id                   String       @id @default(cuid())
  emailMessageId       String
  emailMessage         EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  fileName             String
  storageKey           String
  mimeType             String
  size                 Int
  providerAttachmentId String?

  createdAt DateTime @default(now())

  @@index([emailMessageId])
}

model EmailEvent {
  id              String       @id @default(cuid())
  emailMessageId  String
  emailMessage    EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  eventType       String
  providerEventId String?      @unique
  metadata        Json?
  occurredAt      DateTime
  createdAt       DateTime     @default(now())

  @@index([emailMessageId])
  @@index([eventType])
}

model EmailDraft {
  id        String    @id @default(cuid())
  agentId   String
  agent     Agent     @relation(fields: [agentId], references: [id])
  emailType EmailType
  toEmails  String[]  @default([])
  ccEmails  String[]  @default([])
  bccEmails String[]  @default([])
  subject   String?
  htmlBody  String?   @db.Text
  textBody  String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
}

model SuppressedRecipient {
  email     String   @id
  reason    String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Sales activity & follow-ups
// ---------------------------------------------------------------------------

enum SalesActivityType {
  INITIAL_OUTREACH
  FOLLOW_UP
  DEMO_REQUEST
  MEETING_REQUEST
  PROPOSAL_REQUEST
  NEGOTIATION
  WON
  LOST
  NOT_INTERESTED
  NO_RESPONSE
}

model SalesActivity {
  id             String            @id @default(cuid())
  agentId        String
  agent          Agent             @relation(fields: [agentId], references: [id])
  leadId         String?
  lead           Lead?             @relation(fields: [leadId], references: [id])
  clientId       String?
  client         Client?           @relation(fields: [clientId], references: [id])
  emailMessageId String?
  activityType   SalesActivityType
  notes          String?           @db.Text
  nextFollowUpAt DateTime?
  status         String            @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([leadId])
  @@index([clientId])
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  agentId     String
  agent       Agent        @relation(fields: [agentId], references: [id])
  title       String
  notes       String?      @db.Text
  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id])
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  dueAt       DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([dueAt])
}

// ---------------------------------------------------------------------------
// Commissions
// ---------------------------------------------------------------------------

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  REVERSED
}

model CommissionRule {
  id          String   @id @default(cuid())
  name        String
  sourceType  String // e.g. "PROPOSAL_ACCEPTED", "PROJECT_PAID"
  percentage  Decimal? @db.Decimal(5, 2)
  flatAmount  Decimal? @db.Decimal(12, 2)
  active      Boolean  @default(true)

  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Commission {
  id                 String            @id @default(cuid())
  agentId            String
  agent              Agent             @relation(fields: [agentId], references: [id])
  sourceType         String
  sourceId           String
  commissionRuleId   String?
  commissionRule     CommissionRule?   @relation(fields: [commissionRuleId], references: [id])
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("INR")
  status             CommissionStatus  @default(PENDING)
  calculationSnapshot Json?
  idempotencyKey     String            @unique
  reversalReason     String?           @db.Text

  approvedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([sourceType, sourceId])
}

// ---------------------------------------------------------------------------
// Settings (single-row key/value platform config, e.g. commission defaults)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}